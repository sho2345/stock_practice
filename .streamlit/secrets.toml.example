# このファイルをコピーして「secrets.toml」という名前にし、値を書き換えて使う。
# secrets.toml にはパスワードなどが入るので、GitHub には絶対に上げない（.gitignore で除外済み）。
# Streamlit Community Cloud では、アプリの「Settings → Secrets」に同じ内容を貼り付ける。
#
# どちらのセクションも書かなければ、ログインなし・この PC に保存する「ローカルモード」で動く。

# ---- Google アカウントでのログイン ----
[auth]
# 自分の PC で試すとき：http://localhost:8501/oauth2callback
# 公開するとき：https://（アプリの URL）/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# ログイン状態を記録する Cookie の暗号化に使う、長いランダムな文字列（自分で作る）
cookie_secret = "ここに長いランダムな文字列"
client_id = "（Google Cloud で作った OAuth クライアント ID）"
client_secret = "（Google Cloud で作った OAuth クライアント シークレット）"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- 売買記録を保存するデータベース ----
[database]
# Neon（無料の PostgreSQL）の接続文字列をそのまま貼る
url = "postgresql://ユーザー名:パスワード@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
